# Staging: `bun run dev:staging`, `seed:staging`, `migrate:orders:staging`.
# Copy to .env.staging.local (gitignored) and fill in. Only this file is read
# by those scripts; never put an emulator variable here (they refuse to run).

# Firebase project (not secret)
FIREBASE_PROJECT_ID=millstone-dc47f
FIREBASE_STORAGE_BUCKET=millstone-dc47f.firebasestorage.app

# Absolute path to the service-account JSON, kept outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative to the file, for the hosting step: the same service account as
# variables (the key with \n for line breaks). Used instead of the file when both are set.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Auth.js: a fresh secret for staging (bunx auth secret), not the dev one.
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Seed passwords (at least 8 characters).
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Optional
# DEV_PAGES=true
# ONLINE_PAYMENTS_ENABLED=false
